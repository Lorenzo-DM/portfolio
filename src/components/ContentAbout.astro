---
import { Code } from "astro:components";

const softwareDev = `tech_stack:
  backend:
    - Go_Gin
    - Python_Flask
    - Node_Express
  frontend:
    - React
    - Vue
    - TypeScript
    - TailwindCSS
  databases:
    - PostgreSQL
    - Redis
    - MongoDB

ai_llm:
  - Ollama_self_hosted
  - structured_output
`;

const specialized = `infrastructure:
  cloud_devops:
    - Docker
    - GitHub_Actions
    - Traefik
    - Ansible
    - Bash
  security:
    - OIDC
    - CSP
    - CrowdSec
    - OWASP_auditing
`;

const other = `hobby:
  embedded_iot:
    - ESP32
    - MQTT
    - Zigbee
  interests:
    - self_hosting
    - open_source
    - game_dev
    - 3d_printing
`;
---

<div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
  <!-- Main Column -->
  <div class="border border-gray-700/50 rounded-lg p-1 bg-gray-900/10">
    <Code code={softwareDev} lang="yaml" wrap={true} />
  </div>

  <!-- Secondary Column -->
  <div class="flex flex-col gap-4">
    <div class="border border-gray-700/50 rounded-lg p-1 bg-gray-900/10">
      <Code code={specialized} lang="yaml" wrap={true} />
    </div>
    <div class="border border-gray-700/50 rounded-lg p-1 bg-gray-900/10">
      <Code code={other} lang="yaml" wrap={true} />
    </div>
  </div>
</div>


