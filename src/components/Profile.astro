---
import ProfilePicture from "../assets/profile.png";

const profile = {
  name: "Lorenzo Della Mea",
  title: "Fullstack Engineer · Real-Time Systems",
  location: "Udine, Italy",
  description:
    "Fullstack engineer working on real-time systems. Four years shipping production software for enterprise clients in healthcare logistics and media intelligence, with end-to-end ownership from code to deployment. Security-first by habit: I run the infrastructure I build.",
};
---

<div
  class="flex flex-col gap-6 items-center text-center sm:items-start sm:text-left"
>
  <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
    <img
      src={ProfilePicture.src}
      width={ProfilePicture.width}
      height={ProfilePicture.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      alt={"Profile picture " + profile.name}
      title={profile.name}
      class="w-32 h-auto rounded-xl object-cover mx-auto sm:mx-0"
    />

    <div>
      <h1
        class="text-2xl font-extrabold mb-1 inline-block relative text-secondary"
      >
        {profile.name}
      </h1>

      <p class="text-sm mb-2 text-primary">
        {profile.title}
      </p>

      <p
        class="flex items-center justify-center sm:justify-start text-sm text-gray-400"
      >
        <svg
          class="-mt-0.5 inline mr-2"
          fill="none"
          height="14"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
          ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
          ></path><circle cx="12" cy="10" r="3"></circle></svg
        >
        {profile.location}
      </p>
    </div>
  </div>

  <p class="text-sm leading-relaxed md:mt-4 text-gray-400">
    {profile.description}
  </p>
</div>
