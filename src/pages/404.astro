---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 Not Found | Lorenzo Della Mea"
  description="The requested resource was not found on this server."
>
  <main class="w-full max-w-lg">
    <div
      class="border border-gray-600 rounded-2xl p-8 bg-black shadow-2xl"
    >
      <h1 class="text-6xl font-bold text-primary leading-none mb-3">404</h1>

      <p class="text-secondary text-sm mb-2">Not Found</p>

      <p class="text-gray-400 text-sm leading-relaxed mb-6">
        The requested resource was not found on this server.
      </p>

      <!-- Start: Terminal -->
      <div class="bg-black rounded-lg p-4 border border-gray-600 text-xs">
        <div class="flex items-center">
          <span class="text-primary mr-2">$</span>
          <span class="text-gray-100">head -n 404 /tmp/current_location</span>
        </div>

        <p class="mt-2 text-gray-400">
          head: /tmp/current_location: No such file or directory
        </p>

        <div class="flex items-center mt-2">
          <span class="text-primary mr-2">$</span>
          <span class="text-gray-600">_</span>
        </div>
      </div>
      <!-- End: Terminal -->

      <a
        href="/"
        class="
          block w-full px-4 py-2 mt-6 text-center text-sm font-medium

          border border-gray-600 rounded-lg
          bg-transparent
          text-gray-300

          hover:text-primary
          hover:border-primary
          hover:bg-primary/5
          transition-all duration-300
        "
      >
        cd /home/lorenzo
      </a>
    </div>

    <p class="mt-6 text-center text-xs text-gray-600">
      portfolio.dmlorenzo.it
    </p>
  </main>
</Layout>
